# Modèle de .env pour le cPanel (à copier en `.env` sur le serveur — JAMAIS dans le dépôt).
APP_NAME="SIGH-CNT Relais"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://relais.exemple.bj
APP_KEY=                       # produire avec : php artisan key:generate --show   (sur le poste de développement)
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cpanelutilisateur_relais
DB_USERNAME=cpanelutilisateur_relais
DB_PASSWORD=

# Pas de Redis, pas de démon : tout passe par la base et par le cron.
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=daily
LOG_LEVEL=warning

RELAIS_SECRET_MERE=            # long, aléatoire ; le même est saisi sur la console de la mère
RELAIS_SEUIL_BATTEMENT_MS=300000
RELAIS_BANC=false
